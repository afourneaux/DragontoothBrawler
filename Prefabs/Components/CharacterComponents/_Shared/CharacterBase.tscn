[sub_resource type="GDScript" id="GDScript_7glg2"]
resource_name = "Player"
script/source = "extends CharacterBody2D

@export var input: Node
var parent: Character

const WALLJUMP_FACTOR = 0.8
const WALLJUMP_PUSH = 50

var gravity: float

func _ready():
	parent = get_parent()
	gravity = ProjectSettings.get_setting(\"physics/2d/default_gravity\") * parent.get_floaty_factor()
	set_physics_process(multiplayer.is_server())

func get_player_id():
	return get_parent().player_id

func _physics_process(delta):
	if is_on_wall_only():
		velocity.y = lerpf(velocity.y, 0, delta * parent.get_friction())

	if not is_on_floor():
		velocity.y += gravity * delta
	if input.lr_movement != 0:
		velocity.x = lerpf(velocity.x, input.lr_movement * parent.get_speed(), delta)
	elif is_on_floor():
		velocity.x = lerpf(velocity.x, 0, delta * parent.get_friction())
	move_and_slide()

func jump():
	assert(multiplayer.is_server())
	if is_on_floor():
		velocity.y = -parent.get_jump_height()
	elif is_on_wall():
		velocity.y = -(parent.get_jump_height() * WALLJUMP_FACTOR)
		velocity.x = get_wall_normal().x * WALLJUMP_PUSH
"

