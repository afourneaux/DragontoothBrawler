[sub_resource type="GDScript" id="GDScript_g02fx"]
script/source = "extends Character

func _init():
	character_id = CharacterStats.Character.EIRE

var floaty_factor = 1:
	set(value):
		floaty_factor = value
		on_gravity_changed.emit()
var jump_factor = 1

func get_floaty_factor(): return 2 * floaty_factor
func get_max_health(): return 70
func get_jump_height(): return 800 * jump_factor
"

